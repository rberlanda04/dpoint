rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de evidência dos registros de ponto.
    // Apenas usuários autenticados podem fazer upload, restrito a imagens de até 2MB.
    match /evidencias/{registroId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
